# Backend environment variables
# Copy this file to .env and fill in real values

PORT=5000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=

# Cloudinary credentials (only needed for resume/photo upload features)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origin, used by the CORS allow-list
CLIENT_URL=http://localhost:3000

# Cookie SameSite attribute. Use "lax" for same-origin deploys (recommended:
# backend serves the frontend). Use "none" only if frontend and backend are on
# different domains (then the site must be served over HTTPS).
COOKIE_SAMESITE=lax
